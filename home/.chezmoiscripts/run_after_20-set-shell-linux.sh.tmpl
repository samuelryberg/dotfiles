{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -euo pipefail

username={{ .chezmoi.username | quote }}
fish_path="$(command -v fish || true)"

if [[ -z "$fish_path" ]]; then
  echo "fish is not installed or is not available in PATH." >&2
  exit 1
fi

if ! grep -Fxq "$fish_path" /etc/shells; then
  echo "Registering $fish_path in /etc/shells."
  printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

current_shell="$(getent passwd "$username" | cut -d: -f7)"

if [[ "$current_shell" == "$fish_path" ]]; then
  echo "fish is already the login shell for $username."
  exit 0
fi

echo "Setting fish as the login shell for $username."
sudo chsh -s "$fish_path" "$username"
{{ end -}}
