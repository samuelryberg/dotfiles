{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

username={{ .chezmoi.username | quote }}

if command -v brew >/dev/null 2>&1; then
  brew_bin="$(command -v brew)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  brew_bin=/usr/local/bin/brew
else
  echo "Homebrew is not installed." >&2
  exit 1
fi

fish_path="$("$brew_bin" --prefix)/bin/fish"

if [[ ! -x "$fish_path" ]]; then
  echo "Homebrew's fish is not installed at $fish_path." >&2
  exit 1
fi

if ! grep -Fxq "$fish_path" /etc/shells; then
  echo "Registering $fish_path in /etc/shells."
  printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

current_shell="$(dscl . -read "/Users/$username" UserShell | awk '{print $2}')"

if [[ "$current_shell" == "$fish_path" ]]; then
  echo "fish is already the login shell for $username."
  exit 0
fi

echo "Setting Homebrew's fish as the login shell for $username."
sudo chsh -s "$fish_path" "$username"
{{ end -}}
